-- 二本指ピンチズーム
local touches = {}
local prevDist = nil

local function getPinchDist()
	local pts = {}
	for _, pos in pairs(touches) do
		table.insert(pts, pos)
		if #pts == 2 then
			break
		end
	end
	if #pts < 2 then
		return nil
	end
	return (pts[1] - pts[2]).Magnitude
end

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		touches[input] = Vector2.new(input.Position.X, input.Position.Y)
		prevDist = getPinchDist()
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch and touches[input] then
		touches[input] = Vector2.new(input.Position.X, input.Position.Y)
		local d = getPinchDist()
		if d and prevDist then
			local delta = d - prevDist
			zoomDist = math.clamp(zoomDist - (delta * 0.05), 2, 70)
			pcall(function()
				if thirdPerson then
					player.CameraMinZoomDistance = 2
					player.CameraMaxZoomDistance = math.max(zoomDist + 5, 12)
				else
					player.CameraMinZoomDistance = math.clamp(zoomDist - 1.5, 0.5, 69)
					player.CameraMaxZoomDistance = math.clamp(zoomDist + 1.5, 2, 70)
				end
			end)
		end
		prevDist = d
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		touches[input] = nil
		prevDist = getPinchDist()
	end
end)

