-- 経過時間での演出進行 ＋ 飛行ループ
local t0 = tick()
local doneIntro = false

RunService.Heartbeat:Connect(function(dt)
	-- 文字色の自動変化（虹色グラデーション）
	if autoRainbow then
		rainbowHue = (rainbowHue + dt * rainbowSpeed) % 1
		local autoColor = Color3.fromHSV(rainbowHue, 0.75, 1)
		for _, obj in ipairs(styledLabels) do
			if obj and obj.Parent then
				obj.TextColor3 = autoColor
			end
		end
	end

	if not doneIntro then
		local elapsed = tick() - t0
		if elapsed >= 3.0 then
			local p = (elapsed - 3.0) / 1.5
			if p < 1 then
				welcomeLabel.TextTransparency = p
			else
				welcomeLabel.Visible = false
				panel.Visible = true
				doneIntro = true
			end
		end
	end

	-- ノークリップ処理（飛行のON/OFFとは独立）
	local currentCharacter = player.Character
	if currentCharacter ~= noclipCharacter then
		originalCollision = {}
		noclipCharacter = currentCharacter
	end

	if currentCharacter then
		if noClip then
			for _, part in ipairs(currentCharacter:GetDescendants()) do
				if part:IsA("BasePart") then
					if originalCollision[part] == nil then
						originalCollision[part] = part.CanCollide
					end
					part.CanCollide = false
				end
			end
		else
			for part, oldValue in pairs(originalCollision) do
				if part and part.Parent then
					part.CanCollide = oldValue
				end
			end
			originalCollision = {}
		end
	end

	if not flying then
		return
	end

	pcall(function()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local cam = workspace.CurrentCamera
		if not hum or not hrp or not cam then
			return
		end

		hum.PlatformStand = true
		local moveDir = hum.MoveDirection

		if moveDir.Magnitude > 0.05 then
			local camLook = cam.CFrame.LookVector
			local camRight = cam.CFrame.RightVector
			local rightComp = camRight * moveDir:Dot(camRight)

			local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
			if flatLook.Magnitude > 0.001 then
				flatLook = flatLook.Unit
			end
			local fwdAmt = moveDir:Dot(flatLook)

			local dir = (camLook * fwdAmt) + rightComp
			if dir.Magnitude > 1 then
				dir = dir.Unit
			end

			hrp.AssemblyLinearVelocity = dir * flySpeed
			hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + cam.CFrame.LookVector)
		else
			hrp.AssemblyLinearVelocity = Vector3.new(0, workspace.Gravity * dt, 0)
		end
	end)
end)
