-- アイコンを押すとパネルを再表示。アイコン自体はドラッグ可能
local iconDragging = false
local iconMoved = false
local iconDragStart = Vector2.new(0, 0)
local iconStartPos = miniIcon.Position
local iconActiveInput = nil

miniIcon.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		iconDragging = true
		iconMoved = false
		iconDragStart = Vector2.new(input.Position.X, input.Position.Y)
		iconStartPos = miniIcon.Position
		iconActiveInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not iconDragging then return end

	local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
	local isTouchMove = iconActiveInput and input == iconActiveInput
	if isMouseMove or isTouchMove then
		local current = Vector2.new(input.Position.X, input.Position.Y)
		local delta = current - iconDragStart
		if delta.Magnitude > 5 then
			iconMoved = true
		end
		miniIcon.Position = UDim2.new(
			iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X,
			iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if iconDragging and (
		input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
	) then
		iconDragging = false
		iconActiveInput = nil
	end
end)

miniIcon.Activated:Connect(function()
	if iconMoved then
		iconMoved = false
		return
	end
	miniIcon.Visible = false
	panel.Visible = true
end)

